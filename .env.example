# Substitua os valores entre < > pela connection string do MongoDB Atlas.
# Codifique caracteres especiais da senha na URI e mantenha este arquivo sem credenciais reais.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=interativa_gerenciador
# Opcional para trocar a porta padrao 3022.
# PANEL_PORT=3022
NODE_ENV=development

# Em produção, defina também um segredo aleatório de pelo menos 32 caracteres.
# INITIAL_ADMIN_TOKEN=
